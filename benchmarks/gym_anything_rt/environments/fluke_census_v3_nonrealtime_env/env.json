{
  "id": "gym_anything_rt.fluke_census_v3_nonrealtime_env@0.1",
  "version": "0.1",
  "base": "ubuntu-gnome-systemd_highres",
  "description": "Identify species by sampling live camera specimens, then photograph and landmark each listed moving whale fluke once.",
  "category": [
    "visual_puzzle",
    "captcha_inspired",
    "computer_use"
  ],
  "authors": [
    "Gym-Anything-RT authors"
  ],
  "resources": {
    "cpu": 2,
    "mem_gb": 16,
    "gpu": 0,
    "net": false
  },
  "observation": [
    {
      "type": "frame_window",
      "fps": 10,
      "resolution": [
        1920,
        1080
      ],
      "inline": false
    }
  ],
  "action": [
    {
      "type": "mouse"
    },
    {
      "type": "keyboard"
    }
  ],
  "runner": "gym_anything_rt",
  "runner_options": {
    "play_time_seconds": 240,
    "observation_window_ms": 600,
    "frames_per_observation": 4
  },
  "synchronous": true,
  "step_cycle_ms": 100,
  "recording": {
    "enable": false,
    "output_dir": "benchmarks/gym_anything_rt/environments/fluke_census_v3_nonrealtime_env/artifacts"
  },
  "vnc": {
    "enable": false,
    "host_port": 6178,
    "view_only": false,
    "password": "password"
  },
  "security": {
    "user": "root",
    "cap_drop": [
      "ALL"
    ],
    "privileged": true,
    "use_systemd": true,
    "mount_cgroups": true,
    "cgroupns_host": true,
    "tmpfs_run": true,
    "runtime": "sysbox-runc"
  },
  "mounts": [
    {
      "source": "benchmarks/gym_anything_rt/environments/fluke_census_v3_nonrealtime_env/scripts",
      "target": "/workspace/scripts",
      "mode": "ro"
    },
    {
      "source": "benchmarks/gym_anything_rt/environments/fluke_census_v3_nonrealtime_env/tasks",
      "target": "/workspace/tasks",
      "mode": "ro"
    },
    {
      "source": "benchmarks/gym_anything_rt/shared_runtime",
      "target": "/workspace/shared_runtime",
      "mode": "ro"
    },
    {
      "source": "benchmarks/gym_anything_rt/shared_scripts",
      "target": "/workspace/shared_scripts",
      "mode": "ro"
    }
  ],
  "hooks": {
    "pre_start": "/workspace/scripts/install_puzzle_runtime.sh",
    "post_start": "/workspace/scripts/setup_puzzle_runtime.sh"
  },
  "tags": [
    "linux",
    "browser",
    "visual-puzzle",
    "fluke_census_v3_nonrealtime",
    "moving-camera",
    "individual-memory"
  ]
}
